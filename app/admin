'use client';
import { useState, useEffect } from 'react';
import { createClient } from '@supabase/supabase-js';

const getSupabase = () => {
  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || '';
  const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || '';
  return createClient(supabaseUrl, supabaseAnonKey);
};

export default function AdminDashboard() {
  const [activeTab, setActiveTab] = useState('siswa');
  const [students, setStudents] = useState([]);
  const [soalList, setSoalList] = useState([]);
  const [loading, setLoading] = useState(false);

  // Form State Siswa
  const [nomorUjian, setNomorUjian] = useState('');
  const [namaLengkap, setNamaLengkap] = useState('');
  const [bulkData, setBulkData] = useState('');

  // Form State Soal
  const [pertanyaan, setPertanyaan] = useState('');
  const [opsiA, setOpsiA] = useState('');
  const [opsiB, setOpsiB] = useState('');
  const [opsiC, setOpsiC] = useState('');
  const [opsiD, setOpsiD] = useState('');
  const [kunci, setKunci] = useState('A');

  // Form State Pengaturan
  const [durasi, setDurasi] = useState(60);

  useEffect(() => {
    fetchStudents();
    fetchSoal();
  }, []);

  const fetchStudents = async () => {
    const supabase = getSupabase();
    const { data } = await supabase.from('students').select('*').order('created_at', { ascending: false });
    if (data) setStudents(data);
  };

  const fetchSoal = async () => {
    const supabase = getSupabase();
    const { data } = await supabase.from('soal').select('*').order('id', { ascending: true });
    if (data) setSoalList(data);
  };

  // Tambah Siswa Single
  const handleAddStudent = async (e) => {
    e.preventDefault();
    if (!nomorUjian || !namaLengkap) return;
    setLoading(true);
    const supabase = getSupabase();
    const { error } = await supabase.from('students').insert([
      { nomor_ujian: nomorUjian.trim().toUpperCase(), nama_lengkap: namaLengkap.trim(), is_logged_in: false }
    ]);
    setLoading(false);
    if (error) alert('Gagal menambah siswa: ' + error.message);
    else {
      alert('Siswa berhasil ditambahkan!');
      setNomorUjian('');
      setNamaLengkap('');
      fetchStudents();
    }
  };

  // Import Banyak Siswa dari Excel (Format: Nomor Ujian [TAB] Nama)
  const handleBulkAddStudents = async () => {
    if (!bulkData.trim()) return;
    setLoading(true);
    const rows = bulkData.trim().split('\n');
    const newStudents = rows.map(row => {
      const parts = row.split('\t');
      return {
        nomor_ujian: (parts[0] || '').trim().toUpperCase(),
        nama_lengkap: (parts[1] || parts[0] || '').trim(),
        is_logged_in: false
      };
    }).filter(s => s.nomor_ujian);

    const supabase = getSupabase();
    const { error } = await supabase.from('students').insert(newStudents);
    setLoading(false);
    if (error) alert('Gagal import: ' + error.message);
    else {
      alert(`Berhasil menambahkan ${newStudents.length} siswa!`);
      setBulkData('');
      fetchStudents();
    }
  };

  // Reset Status Login Siswa
  const handleResetLogin = async (nomor) => {
    const supabase = getSupabase();
    await supabase.from('students').update({ is_logged_in: false }).eq('nomor_ujian', nomor);
    fetchStudents();
  };

  // Hapus Siswa
  const handleDeleteStudent = async (id) => {
    if (!confirm('Yakin ingin menghapus siswa ini?')) return;
    const supabase = getSupabase();
    await supabase.from('students').delete().eq('id', id);
    fetchStudents();
  };

  // Tambah Soal
  const handleAddSoal = async (e) => {
    e.preventDefault();
    setLoading(true);
    const supabase = getSupabase();
    const { error } = await supabase.from('soal').insert([
      {
        pertanyaan,
        opsi_a: opsiA,
        opsi_b: opsiB,
        opsi_c: opsiC,
        opsi_d: opsiD,
        kunci_jawaban: kunci
      }
    ]);
    setLoading(false);
    if (error) alert('Gagal menambah soal: ' + error.message);
    else {
      alert('Soal berhasil ditambahkan!');
      setPertanyaan(''); setOpsiA(''); setOpsiB(''); setOpsiC(''); setOpsiD('');
      fetchSoal();
    }
  };

  // Hapus Soal
  const handleDeleteSoal = async (id) => {
    if (!confirm('Yakin ingin menghapus soal ini?')) return;
    const supabase = getSupabase();
    await supabase.from('soal').delete().eq('id', id);
    fetchSoal();
  };

  const copyLinkUjian = () => {
    const link = window.location.origin;
    navigator.clipboard.writeText(link);
    alert('Link Tryout berhasil disalin: ' + link);
  };

  return (
    <div style={{ fontFamily: 'sans-serif', backgroundColor: '#f4f6f9', minHeight: '100vh', padding: '24px' }}>
      <div style={{ maxWidth: '1000px', margin: '0 auto', backgroundColor: '#fff', borderRadius: '12px', padding: '24px', boxShadow: '0 4px 12px rgba(0,0,0,0.05)' }}>
        
        {/* Header Dashboard */}
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '24px', borderBottom: '2px solid #edf2f7', pb: '16px' }}>
          <div>
            <h1 style={{ margin: 0, fontSize: '24px', color: '#1a202c' }}>Dashboard Admin Tryout TKA</h1>
            <p style={{ margin: '4px 0 0', color: '#718096', fontSize: '14px' }}>Kelola data siswa, soal, dan pengaturan ujian tanpa perlu buka GitHub/Vercel</p>
          </div>
          <button onClick={copyLinkUjian} style={{ backgroundColor: '#319795', color: '#fff', border: 'none', padding: '10px 16px', borderRadius: '8px', cursor: 'pointer', fontWeight: 'bold' }}>
            📋 Salin Link Tryout Siswa
          </button>
        </div>

        {/* Tab Navigation */}
        <div style={{ display: 'flex', gap: '8px', marginBottom: '24px' }}>
          {['siswa', 'soal', 'pengaturan'].map((tab) => (
            <button
              key={tab}
              onClick={() => setActiveTab(tab)}
              style={{
                padding: '10px 20px',
                borderRadius: '8px',
                border: 'none',
                cursor: 'pointer',
                fontWeight: 'bold',
                textTransform: 'capitalize',
                backgroundColor: activeTab === tab ? '#3182ce' : '#e2e8f0',
                color: activeTab === tab ? '#fff' : '#4a5568',
              }}
            >
              {tab === 'siswa' ? '👥 Database Siswa' : tab === 'soal' ? '📝 Input & Kelola Soal' : '⚙️ Pengaturan Ujian'}
            </button>
          ))}
        </div>

        {/* TAB 1: DATABASE SISWA */}
        {activeTab === 'siswa' && (
          <div>
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px', marginBottom: '24px' }}>
              {/* Form Manual 1 Siswa */}
              <div style={{ backgroundColor: '#f7fafc', padding: '16px', borderRadius: '8px', border: '1px solid #e2e8f0' }}>
                <h3 style={{ marginTop: 0, fontSize: '16px' }}>Tambah 1 Siswa</h3>
                <form onSubmit={handleAddStudent} style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                  <input type="text" placeholder="Nomor Ujian (Contoh: 20528639-001)" value={nomorUjian} onChange={(e) => setNomorUjian(e.target.value)} style={{ padding: '8px 12px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                  <input type="text" placeholder="Nama Lengkap Siswa" value={namaLengkap} onChange={(e) => setNamaLengkap(e.target.value)} style={{ padding: '8px 12px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                  <button type="submit" disabled={loading} style={{ backgroundColor: '#4299e1', color: '#fff', border: 'none', padding: '8px', borderRadius: '6px', cursor: 'pointer', fontWeight: 'bold' }}>Simpan Siswa</button>
                </form>
              </div>

              {/* Form Paste dari Excel */}
              <div style={{ backgroundColor: '#f7fafc', padding: '16px', borderRadius: '8px', border: '1px solid #e2e8f0' }}>
                <h3 style={{ marginTop: 0, fontSize: '16px' }}>Import Banyak Siswa (Copy-Paste Excel)</h3>
                <textarea
                  rows="4"
                  placeholder="Format: Nomor Ujian [TAB] Nama Lengkap&#10;Contoh:&#10;20528639-001	AHMAD DANI&#10;20528639-002	SITI NURHALIZA"
                  value={bulkData}
                  onChange={(e) => setBulkData(e.target.value)}
                  style={{ width: '100%', padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0', fontSize: '12px', boxSizing: 'border-box' }}
                />
                <button onClick={handleBulkAddStudents} disabled={loading} style={{ backgroundColor: '#38a169', color: '#fff', border: 'none', padding: '8px 16px', borderRadius: '6px', cursor: 'pointer', fontWeight: 'bold', marginTop: '8px' }}>Import Data Excel</button>
              </div>
            </div>

            {/* Tabel Daftar Siswa */}
            <h3>Daftar Peserta Terdaftar ({students.length})</h3>
            <table style={{ width: '100%', borderCollapse: 'collapse', marginTop: '12px' }}>
              <thead>
                <tr style={{ backgroundColor: '#edf2f7', textAlign: 'left' }}>
                  <th style={{ padding: '10px', border: '1px solid #cbd5e0' }}>No Ujian</th>
                  <th style={{ padding: '10px', border: '1px solid #cbd5e0' }}>Nama Lengkap</th>
                  <th style={{ padding: '10px', border: '1px solid #cbd5e0' }}>Status Login</th>
                  <th style={{ padding: '10px', border: '1px solid #cbd5e0' }}>Aksi</th>
                </tr>
              </thead>
              <tbody>
                {students.map((s) => (
                  <tr key={s.id}>
                    <td style={{ padding: '8px', border: '1px solid #e2e8f0', fontWeight: 'bold' }}>{s.nomor_ujian}</td>
                    <td style={{ padding: '8px', border: '1px solid #e2e8f0' }}>{s.nama_lengkap}</td>
                    <td style={{ padding: '8px', border: '1px solid #e2e8f0' }}>
                      <span style={{ backgroundColor: s.is_logged_in ? '#feebc8' : '#c6f6d5', color: s.is_logged_in ? '#c05621' : '#22543d', padding: '4px 8px', borderRadius: '4px', fontSize: '12px', fontWeight: 'bold' }}>
                        {s.is_logged_in ? 'Sedang Aktif' : 'Belum Login'}
                      </span>
                    </td>
                    <td style={{ padding: '8px', border: '1px solid #e2e8f0', display: 'flex', gap: '8px' }}>
                      {s.is_logged_in && (
                        <button onClick={() => handleResetLogin(s.nomor_ujian)} style={{ backgroundColor: '#ed8936', color: '#fff', border: 'none', padding: '4px 8px', borderRadius: '4px', cursor: 'pointer', fontSize: '12px' }}>Reset Status</button>
                      )}
                      <button onClick={() => handleDeleteStudent(s.id)} style={{ backgroundColor: '#e53e3e', color: '#fff', border: 'none', padding: '4px 8px', borderRadius: '4px', cursor: 'pointer', fontSize: '12px' }}>Hapus</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {/* TAB 2: INPUT & KELOLA SOAL */}
        {activeTab === 'soal' && (
          <div>
            <div style={{ backgroundColor: '#f7fafc', padding: '20px', borderRadius: '8px', border: '1px solid #e2e8f0', marginBottom: '24px' }}>
              <h3 style={{ marginTop: 0 }}>Form Tambah Soal Tryout</h3>
              <form onSubmit={handleAddSoal} style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
                <div>
                  <label style={{ fontWeight: 'bold', display: 'block', marginBottom: '4px' }}>Pertanyaan / Soal:</label>
                  <textarea rows="3" value={pertanyaan} onChange={(e) => setPertanyaan(e.target.value)} style={{ width: '100%', padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0', boxSizing: 'border-box' }} required />
                </div>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' }}>
                  <input type="text" placeholder="Pilihan A" value={opsiA} onChange={(e) => setOpsiA(e.target.value)} style={{ padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                  <input type="text" placeholder="Pilihan B" value={opsiB} onChange={(e) => setOpsiB(e.target.value)} style={{ padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                  <input type="text" placeholder="Pilihan C" value={opsiC} onChange={(e) => setOpsiC(e.target.value)} style={{ padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                  <input type="text" placeholder="Pilihan D" value={opsiD} onChange={(e) => setOpsiD(e.target.value)} style={{ padding: '8px', borderRadius: '6px', border: '1px solid #cbd5e0' }} required />
                </div>
                <div>
                  <label style={{ fontWeight: 'bold', marginRight: '8px' }}>Kunci Jawaban Benar:</label>
                  <select value={kunci} onChange={(e) => setKunci(e.target.value)} style={{ padding: '8px 16px', borderRadius: '6px', border: '1px solid #cbd5e0', fontWeight: 'bold' }}>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                  </select>
                </div>
                <button type="submit" disabled={loading} style={{ backgroundColor: '#38a169', color: '#fff', border: 'none', padding: '10px', borderRadius: '6px', cursor: 'pointer', fontWeight: 'bold', marginTop: '8px' }}>Simpan Soal ke Database</button>
              </form>
            </div>

            <h3>Daftar Soal Tersimpan ({soalList.length})</h3>
            {soalList.map((item, idx) => (
              <div key={item.id} style={{ backgroundColor: '#fff', border: '1px solid #e2e8f0', padding: '16px', borderRadius: '8px', marginBottom: '12px' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', fontWeight: 'bold' }}>
                  <span>Soal #{idx + 1}</span>
                  <button onClick={() => handleDeleteSoal(item.id)} style={{ backgroundColor: '#e53e3e', color: '#fff', border: 'none', padding: '4px 8px', borderRadius: '4px', cursor: 'pointer', fontSize: '12px' }}>Hapus Soal</button>
                </div>
                <p style={{ margin: '8px 0', fontSize: '15px' }}>{item.pertanyaan}</p>
                <div style={{ fontSize: '14px', color: '#4a5568', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '4px' }}>
                  <div>A. {item.opsi_a}</div>
                  <div>B. {item.opsi_b}</div>
                  <div>C. {item.opsi_c}</div>
                  <div>D. {item.opsi_d}</div>
                </div>
                <div style={{ marginTop: '8px', fontSize: '13px', fontWeight: 'bold', color: '#2b6cb0' }}>Kunci Jawaban: {item.kunci_jawaban}</div>
              </div>
            ))}
          </div>
        )}

        {/* TAB 3: PENGATURAN */}
        {activeTab === 'pengaturan' && (
          <div style={{ backgroundColor: '#f7fafc', padding: '20px', borderRadius: '8px', border: '1px solid #e2e8f0' }}>
            <h3 style={{ marginTop: 0 }}>Pengaturan Pelaksanaan Tryout</h3>
            <div style={{ marginBottom: '16px' }}>
              <label style={{ display: 'block', fontWeight: 'bold', marginBottom: '6px' }}>Durasi Ujian (Menit):</label>
              <input type="number" value={durasi} onChange={(e) => setDurasi(e.target.value)} style={{ padding: '8px 12px', borderRadius: '6px', border: '1px solid #cbd5e0', width: '150px' }} />
            </div>
            <button onClick={() => alert('Pengaturan durasi disimpan!')} style={{ backgroundColor: '#3182ce', color: '#fff', border: 'none', padding: '8px 16px', borderRadius: '6px', cursor: 'pointer', fontWeight: 'bold' }}>Simpan Pengaturan</button>
          </div>
        )}

      </div>
    </div>
  );
}
